{
  "project": {
    "name": "医学×AI 文献日报",
    "timezone": "Asia/Shanghai"
  },
  "window": {
    "days": 3,
    "max_catchup_days": 30,
    "max_items_per_journal": 60,
    "workers": 6,
    "rss_timeout_seconds": 25,
    "api_timeout_seconds": 45,
    "retries": 2,
    "sources": {
      "rss": true,
      "openalex": true,
      "crossref": true
    }
